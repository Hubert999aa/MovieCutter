{
  "ConnectionStrings": {
    "MovieCutterMSSQL": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "MassTransit": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "",
          "apiKey": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "RabbitMQ": {
    "Host": "",
    "VirtualHost": "",
    "Username": "",
    "Password": "",
    "Port": 0,
    "Queues": {
      "DownloadVideoSettings": {
        "Name": "",
        "PrefetchCount": 0,
        "RetryCount": 0,
        "RetryIntervalSeconds": 0
      },
      "CutVideoIntoFramesSettings": {
        "Name": "",
        "PrefetchCount": 0,
        "RetryCount": 0,
        "RetryIntervalSeconds": 0
      },
      "CutVideoIntoPicesSettings": {
        "Name": "",
        "PrefetchCount": 0,
        "RetryCount": 0,
        "RetryIntervalSeconds": 0
      },
      "DownloadAndCutVideoSettings": {
        "Name": "",
        "PrefetchCount": 0,
        "RetryCount": 0,
        "RetryIntervalSeconds": 0
      }
    }
  }
}